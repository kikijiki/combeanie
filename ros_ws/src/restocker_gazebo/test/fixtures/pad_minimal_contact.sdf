<!-- Bisect step 5 for Card 057: pad_minimal_geometry.sdf plus the bench's block, so the world
     contains a SUSTAINED contact while an unloaded sibling row still has an observable spring.

     Row 0 (in contact): spring_reference -1 mm, so it presses into the block face with 111 N for
     the whole run - exactly the bench's row 0 situation, and the reaction on the finger cancels
     row 1's. Row 1 (unloaded, the bench's rows 2/3): spring_reference +1 mm and its collision
     shifted along x so it never touches the block; it must ring to +1 mm and stop if the engine's
     spring still works while a contact exists.

     Run with RESTOCKER_PAD_SPRING_OFF=1 to watch the engine's own spring only: q must ramp to
     0.001 and stop. The finger is free but has the shipped damping and friction, so it settles
     instead of drifting away. -->
<sdf version="1.9">
  <world name="pad_minimal_contact">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="restocker_pad_spring_system" name="restocker_gazebo::PadSpringSystem"/>

    <physics name="pad_minimal_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <model name="spring_probe">
      <link name="base">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="base_world_joint" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>

      <!-- The moving parent with the shipped finger's real geometry: inertial 7 cm up the z
           axis and the body collision box (no block, so nothing ever touches it). -->
      <link name="finger">
        <pose relative_to="base">0 0 0 0 0 0</pose>
        <inertial>
          <pose>0 0 0.07 0 0 0</pose>
          <mass>0.18</mass>
          <inertia>
            <ixx>0.0003</ixx><iyy>0.0003</iyy><izz>2.324e-05</izz>
          </inertia>
        </inertial>
        <collision name="left_finger_body_collision">
          <pose>0 0.00165 0.07 0 0 0</pose>
          <geometry><box><size>0.035 0.0147 0.14</size></box></geometry>
        </collision>
      </link>
      <joint name="finger_joint" type="prismatic">
        <pose relative_to="base">0 0 0 0 0 0</pose>
        <parent>base</parent>
        <child>finger</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.01</lower><upper>0.035</upper><effort>40</effort><velocity>0.12</velocity></limit>
          <dynamics><damping>2</damping><friction>0.5</friction></dynamics>
        </axis>
      </joint>

      <!-- The pad row with its shipped geometry: the collision box and the centre of mass both
           7 cm up the z axis and 1.3 mm along x from the link frame, exactly as in the bench. -->
      <link name="test_pad_row_0">
        <pose relative_to="finger">0 0 0 0 0 0</pose>
        <inertial>
          <pose>-0.013125 -0.00735 0.07 0 0 0</pose>
          <mass>0.0049</mass>
          <inertia>
            <ixx>8.008e-06</ixx><iyy>8.035e-06</iyy><izz>3.571e-08</izz>
          </inertia>
        </inertial>
        <collision name="test_pad_row_0_collision">
          <pose>-0.013125 -0.00735 0.07 0 0 0</pose>
          <geometry><box><size>0.00875 0.0033 0.14</size></box></geometry>
        </collision>
      </link>
      <joint name="test_pad_row_0_joint" type="prismatic">
        <pose relative_to="finger">0 0 0 0 0 0</pose>
        <parent>finger</parent>
        <child>test_pad_row_0</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.002</lower><upper>0.002</upper><effort>500</effort><velocity>-1</velocity></limit>
          <dynamics><damping>11.5</damping><friction>0</friction><spring_reference>-0.001</spring_reference><spring_stiffness>111000</spring_stiffness></dynamics>
        </axis>
      </joint>

      <!-- The unloaded sibling row: same joint, reference 1 mm the other way, collision shifted
           along x so only row 0 ever meets the block. -->
      <link name="test_pad_row_1">
        <pose relative_to="finger">0 0 0 0 0 0</pose>
        <inertial>
          <pose>-0.004375 -0.00735 0.07 0 0 0</pose>
          <mass>0.0049</mass>
          <inertia>
            <ixx>8.008e-06</ixx><iyy>8.035e-06</iyy><izz>3.571e-08</izz>
          </inertia>
        </inertial>
        <collision name="test_pad_row_1_collision">
          <pose>-0.004375 -0.00735 0.07 0 0 0</pose>
          <geometry><box><size>0.00875 0.0033 0.14</size></box></geometry>
        </collision>
      </link>
      <joint name="test_pad_row_1_joint" type="prismatic">
        <pose relative_to="finger">0 0 0 0 0 0</pose>
        <parent>finger</parent>
        <child>test_pad_row_1</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.002</lower><upper>0.002</upper><effort>500</effort><velocity>-1</velocity></limit>
          <dynamics><damping>11.5</damping><friction>0</friction><spring_reference>0.001</spring_reference><spring_stiffness>111000</spring_stiffness></dynamics>
        </axis>
      </joint>
    </model>

    <!-- The bench's block: face exactly on the rows' inner face at rest, spanning row 0's x only,
         so exactly one row carries a contact and it lasts the whole run. -->
    <model name="block">
      <static>true</static>
      <link name="block_link">
        <collision name="block_collision">
          <pose>-0.013125 -0.034 0.07 0 0 0</pose>
          <geometry><box><size>0.00875 0.05 0.16</size></box></geometry>
        </collision>
      </link>
    </model>
  </world>
</sdf>