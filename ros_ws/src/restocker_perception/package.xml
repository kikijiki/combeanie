<package format="3">
  <name>restocker_perception</name>
  <version>0.1.0</version>
  <description>Backend-neutral RGB-D perception: product detection and 6-DoF pose estimation, and
    depth-derived reconstruction of unmodelled obstacles.</description>
  <maintainer email="dev@kikijiki.com">Matteo Bernacchia</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <depend>eigen</depend>
  <depend>rclcpp</depend>
  <depend>restocker_interfaces</depend>
  <depend>restocker_world_state</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_ros</depend>
  <depend>yaml-cpp</depend>
  <!-- Product registry (Python): Pillow, torch, transformers and rapidocr are optional and absent. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <!-- The Python tests import these as installed packages (lane geometry, catalogue, benchmark scorer). -->
  <test_depend>restocker_benchmarks</test_depend>
  <test_depend>restocker_gazebo</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
