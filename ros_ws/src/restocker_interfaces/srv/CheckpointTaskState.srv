# Checkpoints robot state at an explicit reserved-task transition.
uint8 STAGE_RESERVED=0
uint8 STAGE_ATTACHED=1
uint8 STAGE_DETACHED=2

string token
string operation_id
uint64 expected_reservation_id
uint8 expected_reservation_stage
uint64 expected_reservation_revision
uint8 task_phase
uint8 fault_state
---
restocker_interfaces/WorldStateOperationStatus status
uint64 world_revision
bool has_reservation
restocker_interfaces/TaskReservation reservation
