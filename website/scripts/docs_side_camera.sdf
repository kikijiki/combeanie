<?xml version="1.0" ?>
<sdf version="1.9">
  <!-- World-fixed side camera for docs recording only. Looks along +X of the link. -->
  <model name="docs_side_camera">
    <static>true</static>
    <!-- Pure side view from +X: rail runs across the frame, shelf on +Y, tray on -Y. -->
    <pose>3.4 0.15 1.45 0 0.28 3.14159</pose>
    <link name="link">
      <visual name="visual">
        <geometry><box><size>0.05 0.05 0.05</size></box></geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <sensor name="camera" type="camera">
        <always_on>true</always_on>
        <!-- Keep load low: wrist depth must stay under ~500 ms liveness. -->
        <update_rate>8</update_rate>
        <topic>docs_side_camera</topic>
        <camera>
          <horizontal_fov>1.05</horizontal_fov>
          <image>
            <width>960</width>
            <height>540</height>
          </image>
          <clip>
            <near>0.15</near>
            <far>25</far>
          </clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
