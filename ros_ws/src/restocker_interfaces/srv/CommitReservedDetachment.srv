# Atomically commits a verified detachment. The destination cannot be changed here.
uint8 PLACE_IN_RESERVED_DESTINATION=0
uint8 RELEASE_WITHOUT_MEMBERSHIP=1

string token
string operation_id
uint8 disposition
# Simulation time at which the physical boundary verified the release. A placement is only proven
# by destination evidence recorded after this instant: the gripper carries the product into the
# lane volume before letting go, so earlier evidence proves presence, not placement.
# Required for PLACE_IN_RESERVED_DESTINATION and ignored otherwise.
builtin_interfaces/Time released_at
---
restocker_interfaces/WorldStateOperationStatus status
uint64 world_revision
bool has_reservation
restocker_interfaces/TaskReservation reservation
