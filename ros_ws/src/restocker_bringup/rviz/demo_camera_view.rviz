# Demo camera view layout (Card 028): the MoveIt planning view plus docked panes for the two
# bridged colour camera topics. Selected only when scripts/demo.bash passes
# rviz_config:=.../demo_camera_view.rviz; every other launch keeps moveit.rviz.
#
# The "QMainWindow State" blob docks the panes (Displays+Views left tabified; Overhead Camera
# over Wrist Camera on the right). It was generated with QMainWindow::saveState() from a
# synthetic window carrying these dock object names, built against the same Qt 5.15.19 this
# rviz links (receipts: Backstage evidence/cmbview-028/). A state rviz cannot restore is
# ignored and the panes fall back to floating; nothing else depends on it.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: moveit_rviz_plugin/MotionPlanning
      Enabled: true
      Move Group Namespace: ""
      Name: MotionPlanning
      Planning Group: manipulator
      Robot Description: robot_description
      Scene Robot:
        Attached Body Color: 150; 50; 150
        Show Robot Collision: false
        Show Robot Visual: true
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.2
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Overhead Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /overhead_camera/image
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Wrist Camera
      Normalize Range: true
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /wrist_camera/image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 34; 38; 44
    Fixed Frame: world
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
      Hide Inactive Objects: true
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 4.6
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Current View
      Pitch: 0.35
      Target Frame: world
      Value: Orbit (rviz)
      Yaw: 5.5
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
  Overhead Camera:
    collapsed: false
  QMainWindow State: 
  Views:
    collapsed: false
  Width: 1800
  Wrist Camera:
    collapsed: false
  X: 70
  Y: 50
