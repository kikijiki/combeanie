<!-- Bisect step 6 for Card 057: pad_minimal_moving.sdf with the PARENT DRIVEN hard, which is
     what the bench has and the earlier steps did not: a spring on the finger joint
     (reference -5 mm, 50 kN/m) loads 250 N into the jaw, clipped by its shipped 40 N effort - so
     the parent accelerates at effort/m = 222 m/s^2, the same 40 N drive the probe applies in the
     bench, and then coasts at the shipped 0.12 m/s cap.

     The pad row keeps the pad's own properties (spring 111 kN/m, damping 11.5, velocity
     unbounded, reference +1 mm). With the engine's spring working, the row is carried along and
     its x settles at +1 mm; with it dead, the row is left behind and its x runs to the -2 mm
     travel limit inside 17 ms. Either outcome is decisive at iteration 20.

     Run with RESTOCKER_PAD_SPRING_OFF=1 to watch the engine's own spring only: q must ramp to
     0.001 and stop. The finger is free but has the shipped damping and friction, so it settles
     instead of drifting away. -->
<sdf version="1.9">
  <world name="pad_minimal_drive">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="restocker_pad_spring_system" name="restocker_gazebo::PadSpringSystem"/>

    <physics name="pad_minimal_physics" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <dart>
        <collision_detector>bullet</collision_detector>
      </dart>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <model name="spring_probe">
      <link name="base">
        <inertial>
          <mass>1.0</mass>
          <inertia>
            <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="base_world_joint" type="fixed">
        <parent>world</parent>
        <child>base</child>
      </joint>

      <!-- The moving parent: the shipped finger joint (0.18 kg, damping 2, friction 0.5, effort
           40, velocity 0.12), free to move so the spring's reaction has somewhere to go. -->
      <link name="finger">
        <pose relative_to="base">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.18</mass>
          <inertia>
            <ixx>0.0003</ixx><iyy>0.0003</iyy><izz>2.324e-05</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="finger_joint" type="prismatic">
        <pose relative_to="base">0 0 0 0 0 0</pose>
        <parent>base</parent>
        <child>finger</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.01</lower><upper>0.035</upper><effort>40</effort><velocity>0.12</velocity></limit>
          <dynamics><damping>2</damping><friction>0.5</friction><spring_reference>-0.005</spring_reference><spring_stiffness>50000</spring_stiffness></dynamics>
        </axis>
      </joint>

      <link name="test_pad_row_0">
        <pose relative_to="finger">0 0 0 0 0 0</pose>
        <inertial>
          <mass>0.0049</mass>
          <inertia>
            <ixx>8.008e-06</ixx><iyy>8.035e-06</iyy><izz>3.571e-08</izz>
          </inertia>
        </inertial>
      </link>
      <joint name="test_pad_row_0_joint" type="prismatic">
        <pose relative_to="finger">0 0 0 0 0 0</pose>
        <parent>finger</parent>
        <child>test_pad_row_0</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>-0.002</lower><upper>0.002</upper><effort>500</effort><velocity>-1</velocity></limit>
          <dynamics><damping>11.5</damping><friction>0</friction><spring_reference>0.001</spring_reference><spring_stiffness>111000</spring_stiffness></dynamics>
        </axis>
      </joint>
    </model>
  </world>
</sdf>