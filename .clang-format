BasedOnStyle: Google
Language: Cpp
Standard: c++20
ColumnLimit: 100
AccessModifierOffset: -2
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: false
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterUnion: true
  BeforeCatch: false
  BeforeElse: false
DerivePointerAlignment: false
PointerAlignment: Right
SortIncludes: Never
